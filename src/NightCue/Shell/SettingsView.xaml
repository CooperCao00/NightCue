<Viewbox xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Stretch="Uniform">
 <Grid x:Name="Scene" Width="1000" Height="790" Background="{DynamicResource Page}" TextElement.FontFamily="{DynamicResource UiFont}" TextElement.FontSize="13" TextElement.Foreground="{DynamicResource Ink}" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid.Resources>
   <SolidColorBrush x:Key="Page" Color="#F6F7FB"/><SolidColorBrush x:Key="Card" Color="#FFFFFF"/>
   <SolidColorBrush x:Key="Ink" Color="#242737"/><SolidColorBrush x:Key="Muted" Color="#85899B"/>
   <SolidColorBrush x:Key="Line" Color="#E7E9F1"/><SolidColorBrush x:Key="Field" Color="#F7F8FC"/>
   <SolidColorBrush x:Key="Accent" Color="#7868DE"/><SolidColorBrush x:Key="Tint" Color="#F0EDFF"/>
   <SolidColorBrush x:Key="Hover" Color="#EEEAFB"/><SolidColorBrush x:Key="Track" Color="#DADDE8"/>
   <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/><Setter Property="Foreground" Value="{DynamicResource Ink}"/></Style>
   <Style x:Key="Small" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Muted}"/><Setter Property="FontSize" Value="12"/></Style>
   <Style x:Key="CardBox" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Card}"/><Setter Property="CornerRadius" Value="16"/><Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/></Style>
   <Style TargetType="Button">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="{DynamicResource Card}"/>
    <Setter Property="BorderBrush" Value="{DynamicResource Line}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="18,10"/>
    <Setter Property="Cursor" Value="Hand"/><Setter Property="FontFamily" Value="{DynamicResource UiFont}"/><Setter Property="FontSize" Value="13"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border><ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.8"/></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Opacity" Value="0.6"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Accent}"/><Setter TargetName="Frame" Property="BorderThickness" Value="2"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger>
     </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style x:Key="Input" TargetType="TextBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
    <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="29"/><Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="Padding" Value="0"/><Setter Property="CaretBrush" Value="{DynamicResource Accent}"/><Setter Property="SelectionBrush" Value="#A5A0DF"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox"><Border BorderThickness="0,0,0,2" BorderBrush="Transparent" x:Name="InputLine"><ScrollViewer x:Name="PART_ContentHost"/></Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputLine" Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="ToggleButton">
    <Setter Property="Width" Value="42"/><Setter Property="Height" Value="24"/><Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
     <Border x:Name="Track" Background="{DynamicResource Track}" CornerRadius="12" BorderBrush="Transparent" BorderThickness="1">
      <Ellipse x:Name="Thumb" Fill="White" Width="18" Height="18" Margin="2" HorizontalAlignment="Left"/>
     </Border><ControlTemplate.Triggers>
      <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/><Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/></Trigger>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Track" Property="Opacity" Value="0.8"/></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger>
     </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>

   <Style TargetType="ComboBoxItem">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="Padding" Value="10,7"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border Name="ItemBorder" Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Tint}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource Tint}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>
   <Style TargetType="ComboBox">
    <Setter Property="Foreground" Value="{DynamicResource Ink}"/><Setter Property="FontFamily" Value="{DynamicResource UiFont}"/>
    <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
     <ToggleButton Focusable="False" Width="Auto" Height="Auto" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
      <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource Field}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="7" Padding="10,5"><Grid><TextBlock Text="⌄" Foreground="{DynamicResource Ink}" HorizontalAlignment="Right"/><ContentPresenter Margin="0,0,20,0" VerticalAlignment="Center"/></Grid></Border></ControlTemplate></ToggleButton.Template>
      <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/>
     </ToggleButton>
     <Popup Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource Card}" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="4" CornerRadius="8"><ScrollViewer MaxHeight="320" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   </Style>
  </Grid.Resources>
  <Grid.ColumnDefinitions><ColumnDefinition Width="292"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#20243E"/><GradientStop Color="#151B31" Offset="0.65"/><GradientStop Color="#24203E" Offset="1"/></LinearGradientBrush></Border.Background>
   <Grid>
    <StackPanel Orientation="Horizontal" Margin="30,30,0,0" VerticalAlignment="Top">
     <Border Background="#373754" CornerRadius="10" Width="36" Height="36"><Path Data="M 21,7 C 10,6 5,17 12,24 C 18,31 29,27 30,20 C 20,24 15,15 21,7 Z" Fill="#E9C991" Width="25" Height="25" Stretch="Uniform"/></Border>
     <StackPanel Margin="11,0,0,0"><TextBlock Text="NightCue" Foreground="#F4F2FA" FontWeight="SemiBold" FontSize="17"/><TextBlock Text="N I G H T   C U E" Foreground="#9092AC" FontSize="9" Margin="0,4,0,0"/></StackPanel>
    </StackPanel>
    <Canvas Width="270" Height="250" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,94,0,0" IsHitTestVisible="False">
     <Ellipse Width="246" Height="246" Canvas.Left="12" Canvas.Top="0" Stroke="#32334F" StrokeThickness="1"/>
     <Ellipse Width="194" Height="194" Canvas.Left="38" Canvas.Top="26" Stroke="#393952" StrokeThickness="1"/>
     <Ellipse Width="154" Height="154" Canvas.Left="58" Canvas.Top="46"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#45405A"/><GradientStop Color="#0020243E" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
     <Path Data="M 105,54 C 49,52 36,123 78,153 C 116,180 160,155 166,123 C 120,145 79,101 105,54 Z" Canvas.Left="22" Canvas.Top="21">
      <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FFF0CE"/><GradientStop Color="#DDBB80" Offset="1"/></LinearGradientBrush></Path.Fill>
     </Path>
     <Path Data="M 0,7 L 5,5 L 7,0 L 9,5 L 14,7 L 9,9 L 7,14 L 5,9 Z" Fill="#DECCAC" Canvas.Left="189" Canvas.Top="65"/>
     <Ellipse Width="5" Height="5" Fill="#A79BC6" Canvas.Left="55" Canvas.Top="56"/>
     <Ellipse Width="4" Height="4" Fill="#8E8BAF" Canvas.Left="193" Canvas.Top="181"/>
     <Ellipse Width="7" Height="7" Fill="#8E83BA" Canvas.Left="12" Canvas.Top="122"/>
     <Ellipse Width="4" Height="4" Fill="#B9ADCB" Canvas.Left="241" Canvas.Top="136"/>
    </Canvas>
    <StackPanel Margin="30,354,25,0" VerticalAlignment="Top">
     <TextBlock Name="HeroTitle" Text="{DynamicResource T.HeroTitle}" FontSize="24" FontWeight="SemiBold" Foreground="#F1EFF8" TextWrapping="Wrap"/>
     <TextBlock Name="HeroBody" Text="{DynamicResource T.HeroBody}" FontSize="13" LineHeight="24" Foreground="#9FA3BC" Margin="0,19,0,0"/>
     <Button Name="RecoveryDismissButton" Content="{DynamicResource T.RecoveryAcknowledge}" Visibility="Collapsed" FontSize="11" Padding="10,7" Margin="0,16,0,0"/>
    </StackPanel>
    <Border Name="CueStatusCard" Margin="24,0,24,62" VerticalAlignment="Bottom" Background="#292E48" CornerRadius="12" Padding="15,14">
     <StackPanel><StackPanel Orientation="Horizontal"><Ellipse Name="StatusDot" Width="6" Height="6" Fill="#E8C58D" Margin="0,0,7,0"/><TextBlock Name="StatusHeading" Text="" Foreground="#E8C58D" FontSize="12"/></StackPanel><TextBlock Name="StatusText" Text="" Foreground="#C4C6D6" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap" LineHeight="19"/></StackPanel>
    </Border>
    <TextBlock Text="{DynamicResource T.QuietFooter}" Width="244" TextAlignment="Center" Foreground="#7E829E" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
   </Grid>
  </Border>
  <Grid Grid.Column="1" Margin="34,26,34,24">
   <Grid.RowDefinitions><RowDefinition Height="66"/><RowDefinition Height="103"/><RowDefinition Height="16"/><RowDefinition Height="168"/><RowDefinition Height="16"/><RowDefinition Height="293"/><RowDefinition Height="*"/><RowDefinition Height="43"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="{DynamicResource T.PageTitle}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource T.PageSubtitle}" Style="{StaticResource Small}" Margin="0,8,0,0"/></StackPanel>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Button Name="LightButton" Grid.Column="0" Padding="16,14" AutomationProperties.Name="{DynamicResource T.SwitchLight}">
     <Grid Width="270"><Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#F0F1F6" BorderBrush="#DEE1EA" BorderThickness="1" CornerRadius="8" Width="54" Height="55" HorizontalAlignment="Left">
       <Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Ellipse Width="3" Height="3" Fill="#B8BDCC" Margin="0,0,3,0"/><Ellipse Width="3" Height="3" Fill="#B8BDCC"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="11"/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#DFE2ED" CornerRadius="2"/><Border Grid.Column="2" Background="White" CornerRadius="3"/></Grid></Grid>
      </Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{DynamicResource T.LightTitle}" FontSize="14" FontWeight="SemiBold"/><TextBlock Name="LightCaption" Text="{DynamicResource T.LightIdle}" Style="{StaticResource Small}" Margin="0,7,0,0"/></StackPanel>
     </Grid>
    </Button>
    <Button Name="DarkButton" Grid.Column="2" Padding="16,14" AutomationProperties.Name="{DynamicResource T.SwitchDark}">
     <Grid Width="270"><Grid.ColumnDefinitions><ColumnDefinition Width="66"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Border Background="#24283D" BorderBrush="#35394F" BorderThickness="1" CornerRadius="8" Width="54" Height="55" HorizontalAlignment="Left"><Grid Margin="6"><Grid.RowDefinitions><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel Orientation="Horizontal"><Ellipse Width="3" Height="3" Fill="#717793" Margin="0,0,3,0"/><Ellipse Width="3" Height="3" Fill="#717793"/></StackPanel><Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="11"/><ColumnDefinition Width="4"/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#393F59" CornerRadius="2"/><Border Grid.Column="2" Background="#4D5270" CornerRadius="3"/></Grid></Grid></Border>
      <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{DynamicResource T.DarkTitle}" FontSize="14" FontWeight="SemiBold"/><TextBlock Name="DarkCaption" Text="{DynamicResource T.DarkIdle}" Style="{StaticResource Small}" Margin="0,7,0,0"/></StackPanel>
     </Grid>
    </Button>
   </Grid>
   <Border Name="TimeGroup" Grid.Row="3" Style="{StaticResource CardBox}" Padding="20,17">
    <Grid><Grid.RowDefinitions><RowDefinition Height="20"/><RowDefinition Height="83"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <Grid><TextBlock Text="{DynamicResource T.WindowLabel}" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource T.EveryDay}" HorizontalAlignment="Right" Style="{StaticResource Small}"/></Grid>
     <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="38"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource Field}" CornerRadius="10" Padding="15,8"><StackPanel><TextBlock Text="{DynamicResource T.Start}" Style="{StaticResource Small}"/><TextBox Name="StartTime" Style="{StaticResource Input}" MaxLength="5" AutomationProperties.Name="{DynamicResource T.Start}"/></StackPanel></Border>
      <TextBlock Text="→" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="18"/>
      <Border Grid.Column="2" Background="{DynamicResource Field}" CornerRadius="10" Padding="15,8"><StackPanel><TextBlock Name="EndLabel" Style="{StaticResource Small}"/><TextBox Name="EndTime" Style="{StaticResource Input}" MaxLength="5" AutomationProperties.Name="{DynamicResource T.End}"/></StackPanel></Border>
     </Grid>
     <TextBlock Name="TimeFeedback" Grid.Row="2" Text="{DynamicResource T.TimeHint}" Style="{StaticResource Small}" VerticalAlignment="Bottom"/>
    </Grid>
   </Border>
   <Border Grid.Row="5" Style="{StaticResource CardBox}" Padding="20,0">
    <Grid><Grid.RowDefinitions><RowDefinition Height="50"/><RowDefinition Height="1"/><RowDefinition Height="90"/><RowDefinition Height="1"/><RowDefinition Height="49"/><RowDefinition Height="1"/><RowDefinition Height="50"/><RowDefinition Height="1"/><RowDefinition Height="49"/></Grid.RowDefinitions>
     <Grid><StackPanel MaxWidth="310" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{DynamicResource T.SnoozeLabel}"/><TextBlock Name="MinutesFeedback" FontSize="11" Foreground="#DB866E" Visibility="Collapsed" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Name="Minus" Content="−" Width="29" Height="29" Padding="0" Background="{DynamicResource Field}" AutomationProperties.Name="{DynamicResource T.LessMinutes}"/><TextBox Name="Minutes" Style="{StaticResource Input}" FontSize="15" FontWeight="SemiBold" Width="36" TextAlignment="Center" MaxLength="3" Margin="3,0" AutomationProperties.Name="{DynamicResource T.SnoozeLabel}"/><TextBlock Text="{DynamicResource T.Minutes}" Style="{StaticResource Small}" VerticalAlignment="Center" Margin="1,0,11,0"/><Button Name="Plus" Content="+" Width="29" Height="29" Padding="0" Background="{DynamicResource Field}" AutomationProperties.Name="{DynamicResource T.MoreMinutes}"/></StackPanel></Grid>
     <Border Grid.Row="1" Background="{DynamicResource Line}"/>
     <Grid Grid.Row="2" Margin="0,6"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="27"/><RowDefinition Height="27"/></Grid.RowDefinitions>
      <TextBlock Text="{DynamicResource T.StartupLabel}" VerticalAlignment="Center"/>
      <ToggleButton Name="StartupToggle" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource T.StartupLabel}" ToolTip="{DynamicResource T.StartupSub}"/>
      <TextBlock Name="StartupStatus" Grid.Row="1" FontSize="11" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"/>
      <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Button Name="StartupWindowsButton" Content="{DynamicResource T.StartupWindows}" FontSize="11" Padding="8,3" Background="{DynamicResource Field}"/>
       <Button Name="DiagnosticsButton" Grid.Column="2" Content="{DynamicResource T.StartupDiagnostics}" FontSize="11" Padding="8,3" Background="{DynamicResource Field}"/>
      </Grid>
     </Grid>
     <Border Grid.Row="3" Background="{DynamicResource Line}"/>
     <Grid Grid.Row="4"><StackPanel MaxWidth="240" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{DynamicResource T.HotkeyLabel}"/><TextBlock Name="HotkeyFeedback" FontSize="11" Foreground="#DB866E" Visibility="Collapsed" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel><Border Background="{DynamicResource Field}" CornerRadius="5" HorizontalAlignment="Right" Margin="0,0,58,0" VerticalAlignment="Center" Padding="8,4"><TextBlock Name="ShortcutHint" Text="Ctrl + Alt + Shift + D" Foreground="{DynamicResource Muted}" FontFamily="Segoe UI" FontSize="11"/></Border><ToggleButton Name="HotkeyToggle" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource T.HotkeyLabel}"/></Grid>

     <Border Grid.Row="5" Background="{DynamicResource Line}"/>
     <Grid Grid.Row="6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="292"/></Grid.ColumnDefinitions><StackPanel VerticalAlignment="Center"><TextBlock Text="{DynamicResource T.LanguageLabel}"/><TextBlock Name="LanguageFeedback" FontSize="11" Foreground="#DB866E" Visibility="Collapsed" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel><ComboBox Name="LanguageChoice" Grid.Column="1" VerticalAlignment="Center" Height="34" AutomationProperties.Name="{DynamicResource T.LanguageLabel}"/></Grid>
     <Border Grid.Row="7" Background="{DynamicResource Line}"/>
     <Grid Grid.Row="8"><StackPanel MaxWidth="510" HorizontalAlignment="Left" VerticalAlignment="Center"><TextBlock Text="{DynamicResource T.MorningLabel}"/><TextBlock Name="MorningFeedback" FontSize="11" Foreground="#DB866E" Visibility="Collapsed" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel><ToggleButton Name="MorningToggle" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource T.MorningLabel}"/></Grid>
    </Grid>
   </Border>
   <TextBlock Grid.Row="6" Name="Feedback" Text="" Foreground="#DB866E" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center"/>
   <Grid Grid.Row="7"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button Name="MoreButton" Content="{DynamicResource T.More}" Padding="15,8" Background="Transparent"/><TextBlock Grid.Column="1" Text="{DynamicResource T.HideHint}" TextAlignment="Center" Margin="10,0" FontSize="11" Style="{StaticResource Small}" VerticalAlignment="Center" HorizontalAlignment="Center"/><Button Name="HideButton" Grid.Column="2" Content="{DynamicResource T.Hide}" Background="{DynamicResource Accent}" BorderBrush="{DynamicResource Accent}" Foreground="White" Padding="24,10"/></Grid>
  </Grid>
 </Grid>
</Viewbox>
